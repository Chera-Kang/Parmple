# =============================================================================
# Parmple E2E Automation - Environment Variables Template
# 실제 사용 시 이 파일을 복사하여 '.env'로 이름을 변경하고 실제 값을 입력하세요.
# =============================================================================

# [0] Target Endpoints (미설정 시 기본 QA 서버 타겟)
BASE_URL=https://qa.erp.parmple.com/
ADMIN_URL=https://qa.admin.parmple.com/
ADMIN_API_URL=https://qa.api.parmple.com

# [1] Gmail Auth (회원가입 OTP 자동 파싱용 - email_reader.py)
EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

# [2] Test Accounts (Role-based Fixtures & API)
ADMIN_EMAIL=admin@example.com
ID_CSO=cso1@example.com
ID_CSO2=cso2@example.com
ID_CSO3=cso3@example.com
ID_PHARM_1=pharm1@example.com
ID_PHARM_2=pharm2@example.com

# [3] Password
PASSWORD=your_test_password123!

# [4] Google Sheet Auth (테스트용 사업자등록번호 풀 시트 ID)
GSHEET_KEY=your_google_sheet_key_here

# [5] Google Gemini API Key (Self-Healing 자가 치유 파이프라인)
GEMINI_API_KEY=your_gemini_api_key_here

# [6] Figma REST API Access Token (Figma 기반 제로베이스 TC 설계)
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here
